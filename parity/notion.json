{
  "about": "Every Notion editing feature, and what BlockMD does about it. Sources: notion.com/help/writing-and-editing-basics and notion.com/help/keyboard-shortcuts (read 2026-09-29). status: 'must' = Markdown can store it, so BlockMD must do it, and `npm run parity` checks it in the real app; 'planned' = storable, not built yet; 'wontdo' = Markdown has no way to store it (P0: files stay plain .md). Every 'must' needs a `check` that exists in scripts/parity.mjs, or the run fails.",
  "features": [
    { "id": "open-save-identical", "area": "Fidelity", "feature": "Open and save without editing changes nothing", "status": "must", "check": "fidelity-untouched" },
    { "id": "edit-keeps-style", "area": "Fidelity", "feature": "Editing a block keeps that block's original Markdown style", "status": "must", "check": "fidelity-edit-style" },
    { "id": "edit-only-that-block", "area": "Fidelity", "feature": "Editing a block leaves every other block byte-identical", "status": "must", "check": "fidelity-edit-isolated" },

    { "id": "text", "area": "Blocks", "feature": "Text", "status": "must", "check": "render-paragraph" },
    { "id": "headings", "area": "Blocks", "feature": "Heading 1 / 2 / 3", "status": "must", "check": "render-headings" },
    { "id": "bulleted-list", "area": "Blocks", "feature": "Bulleted list, nested", "status": "must", "check": "render-bullets" },
    { "id": "numbered-list", "area": "Blocks", "feature": "Numbered list", "status": "must", "check": "render-numbered" },
    { "id": "todo", "area": "Blocks", "feature": "To-do list with clickable checkboxes", "status": "must", "check": "render-todo" },
    { "id": "quote", "area": "Blocks", "feature": "Quote", "status": "must", "check": "render-quote" },
    { "id": "callout", "area": "Blocks", "feature": "Callout", "status": "must", "check": "render-callout", "note": "Stored as GitHub/Obsidian `> [!NOTE]`" },
    { "id": "divider", "area": "Blocks", "feature": "Divider", "status": "must", "check": "render-divider" },
    { "id": "code-block", "area": "Blocks", "feature": "Code block", "status": "must", "check": "render-code" },
    { "id": "code-highlight", "area": "Blocks", "feature": "Code block syntax highlighting", "status": "must", "check": "render-code-highlight" },
    { "id": "code-language", "area": "Blocks", "feature": "Choose a code block's language", "status": "must", "check": "code-language-picker", "note": "Stored as the fence's info string (```js)" },
    { "id": "table", "area": "Blocks", "feature": "Simple table", "status": "must", "check": "render-table", "note": "GFM table" },
    { "id": "image-local", "area": "Blocks", "feature": "Image next to the file (relative path)", "status": "must", "check": "render-image-local" },
    { "id": "image-web", "area": "Blocks", "feature": "Image from the web", "status": "must", "check": "render-image-web" },
    { "id": "equation-block", "area": "Blocks", "feature": "Block equation", "status": "must", "check": "render-math-block", "note": "`$$ … $$`, which GitHub renders" },
    { "id": "toggle", "area": "Blocks", "feature": "Toggle list", "status": "planned", "note": "Storable as HTML `<details><summary>`, which GitHub renders; needs a new node type and remark config (iron rule 2)" },
    { "id": "columns", "area": "Blocks", "feature": "Columns (blocks side by side)", "status": "planned", "note": "ADR-004: v1 read-only atomic block, v2 custom schema" },
    { "id": "media-links", "area": "Blocks", "feature": "Video, audio, file, PDF, bookmark", "status": "planned", "note": "Markdown can only store these as links; a nicer rendering of such links is possible" },
    { "id": "toc", "area": "Blocks", "feature": "Table of contents", "status": "wontdo", "note": "No Markdown syntax; `[TOC]` is non-standard and would show as text everywhere else" },
    { "id": "database", "area": "Blocks", "feature": "Databases (table, board, gallery, list, calendar views)", "status": "wontdo", "note": "No Markdown representation" },
    { "id": "synced", "area": "Blocks", "feature": "Synced blocks, link to page, breadcrumb, button, template", "status": "wontdo", "note": "Need block IDs or page hierarchy stored in the file" },
    { "id": "embeds", "area": "Blocks", "feature": "Embeds (Figma, Google Drive, Tweet, …)", "status": "wontdo", "note": "Would need iframes in the file; stays a plain link" },

    { "id": "bold", "area": "Inline", "feature": "Bold", "status": "must", "check": "render-inline" },
    { "id": "italic", "area": "Inline", "feature": "Italic", "status": "must", "check": "render-inline" },
    { "id": "inline-code", "area": "Inline", "feature": "Inline code", "status": "must", "check": "render-inline" },
    { "id": "strike", "area": "Inline", "feature": "Strikethrough", "status": "must", "check": "render-inline" },
    { "id": "link", "area": "Inline", "feature": "Link", "status": "must", "check": "render-inline" },
    { "id": "equation-inline", "area": "Inline", "feature": "Inline equation", "status": "must", "check": "render-math-inline", "note": "`$ … $`, which GitHub renders" },
    { "id": "underline", "area": "Inline", "feature": "Underline", "status": "wontdo", "note": "No Markdown syntax" },
    { "id": "color", "area": "Inline", "feature": "Text colour and highlight", "status": "wontdo", "note": "No Markdown syntax" },
    { "id": "mentions", "area": "Inline", "feature": "@-mentions, dates, reminders", "status": "wontdo", "note": "Need a user or page database" },
    { "id": "emoji-picker", "area": "Inline", "feature": "Emoji picker (`:` or /emoji)", "status": "planned", "note": "Stored as the emoji character, so fully storable" },

    { "id": "md-bold", "area": "Markdown shortcuts", "feature": "**text** makes bold", "status": "must", "check": "shortcut-inline-bold" },
    { "id": "md-italic", "area": "Markdown shortcuts", "feature": "*text* makes italic", "status": "must", "check": "shortcut-inline-italic" },
    { "id": "md-code", "area": "Markdown shortcuts", "feature": "`text` makes inline code", "status": "must", "check": "shortcut-inline-code" },
    { "id": "md-strike", "area": "Markdown shortcuts", "feature": "~text~ makes strikethrough", "status": "must", "check": "shortcut-inline-strike" },
    { "id": "md-bullet", "area": "Markdown shortcuts", "feature": "- , * or + then space starts a bulleted list", "status": "must", "check": "shortcut-bullet" },
    { "id": "md-todo", "area": "Markdown shortcuts", "feature": "[] then space starts a to-do", "status": "must", "check": "shortcut-todo" },
    { "id": "md-numbered", "area": "Markdown shortcuts", "feature": "1. then space starts a numbered list", "status": "must", "check": "shortcut-numbered" },
    { "id": "md-headings", "area": "Markdown shortcuts", "feature": "#, ##, ### then space make headings", "status": "must", "check": "shortcut-headings" },
    { "id": "md-quote", "area": "Markdown shortcuts", "feature": "\" then space makes a quote (> also, as in Markdown)", "status": "must", "check": "shortcut-quote", "note": "In Notion `>` makes a toggle; here `>` keeps its Markdown meaning" },
    { "id": "md-divider", "area": "Markdown shortcuts", "feature": "--- makes a divider", "status": "must", "check": "shortcut-divider" },
    { "id": "md-code-block", "area": "Markdown shortcuts", "feature": "``` makes a code block", "status": "must", "check": "shortcut-code-block" },

    { "id": "kb-bold", "area": "Keyboard", "feature": "Ctrl+B bold", "status": "must", "check": "key-bold" },
    { "id": "kb-italic", "area": "Keyboard", "feature": "Ctrl+I italic", "status": "must", "check": "key-italic" },
    { "id": "kb-code", "area": "Keyboard", "feature": "Ctrl+E inline code", "status": "must", "check": "key-code" },
    { "id": "kb-strike", "area": "Keyboard", "feature": "Ctrl+Shift+S strikethrough", "status": "must", "check": "key-strike" },
    { "id": "kb-link", "area": "Keyboard", "feature": "Ctrl+K add link", "status": "must", "check": "key-link" },
    { "id": "kb-underline", "area": "Keyboard", "feature": "Ctrl+U underline", "status": "wontdo", "note": "No Markdown underline" },
    { "id": "kb-undo", "area": "Keyboard", "feature": "Ctrl+Z undo, Ctrl+Shift+Z / Ctrl+Y redo", "status": "must", "check": "key-undo-redo" },
    { "id": "kb-indent", "area": "Keyboard", "feature": "Tab / Shift+Tab nest and un-nest list items", "status": "must", "check": "key-indent" },
    { "id": "kb-turn-into", "area": "Keyboard", "feature": "Ctrl+Shift+0…8 turn into text, H1–H3, to-do, bullet, number, (toggle), code", "status": "must", "check": "key-turn-into" },
    { "id": "kb-duplicate", "area": "Keyboard", "feature": "Ctrl+D duplicate block", "status": "must", "check": "key-duplicate" },
    { "id": "kb-move", "area": "Keyboard", "feature": "Ctrl+Shift+↑/↓ move block", "status": "must", "check": "key-move" },
    { "id": "kb-select-delete", "area": "Keyboard", "feature": "Esc selects the block, Backspace deletes it", "status": "must", "check": "key-select-delete" },
    { "id": "kb-block-menu", "area": "Keyboard", "feature": "Ctrl+/ opens the block menu", "status": "must", "check": "key-block-menu" },
    { "id": "kb-find", "area": "Keyboard", "feature": "Ctrl+F find in page", "status": "must", "check": "key-find" },

    { "id": "slash-menu", "area": "Interaction", "feature": "/ opens a menu of blocks, filtered as you type", "status": "must", "check": "slash-menu" },
    { "id": "plus-button", "area": "Interaction", "feature": "+ button adds a block below", "status": "must", "check": "plus-button" },
    { "id": "drag-reorder", "area": "Interaction", "feature": "Drag a block by its handle to move it", "status": "must", "check": "drag-reorder" },
    { "id": "drop-indicator", "area": "Interaction", "feature": "A line shows where a dragged block will land", "status": "must", "check": "drop-indicator" },
    { "id": "block-menu", "area": "Interaction", "feature": "Handle menu: Turn into, Duplicate, Delete", "status": "must", "check": "block-menu" },
    { "id": "format-toolbar", "area": "Interaction", "feature": "Selecting text shows a formatting toolbar", "status": "must", "check": "format-toolbar" },
    { "id": "paste-markdown", "area": "Interaction", "feature": "Pasting Markdown text creates the matching blocks", "status": "must", "check": "paste-markdown" },
    { "id": "dark-mode", "area": "Interaction", "feature": "Dark mode", "status": "must", "check": "dark-mode", "note": "Follows the system setting" },
    { "id": "image-paste", "area": "Interaction", "feature": "Paste or drop an image file", "status": "planned", "note": "Needs to write the image next to the .md file; a design decision about where" },
    { "id": "multi-select", "area": "Interaction", "feature": "Select several blocks and move / delete them together", "status": "planned" },
    { "id": "typography", "area": "Interaction", "feature": "Page style: serif / mono font, small text, full width", "status": "planned", "note": "An app setting, not stored in the file" },
    { "id": "comments", "area": "Interaction", "feature": "Comments and suggested edits", "status": "wontdo", "note": "No Markdown representation" }
  ]
}
