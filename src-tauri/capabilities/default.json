{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "File dialogs plus the two custom byte-level file commands. No fs plugin: see src/lib.rs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
