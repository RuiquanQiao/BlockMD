{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "File dialogs, the two custom byte-level file commands, and self-update. No fs plugin: see src/lib.rs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "updater:default",
    "process:allow-restart"
  ]
}
