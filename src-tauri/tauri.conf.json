{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlockMD",
  "version": "0.1.8",
  "identifier": "dev.blockmd.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BlockMD",
        "width": 1100,
        "height": 780,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDMTNFMDcwQUYyM0M3Q0EKUldUS3h5T3ZjT0FUZkJjcXJTeEZXTVIrQVkycWxoM3RxY1JVZExnNXpLcnBCbjVlMmNDR3ZObzkK",
      "endpoints": [
        "https://github.com/RuiquanQiao/BlockMD/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "A Notion-style block editor whose files are just plain .md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/shell-registration.wxs"],
        "componentGroupRefs": ["ShellRegistration"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "BlockMD.md",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
