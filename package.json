{
  "name": "blockmd",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A Notion-style block editor whose files are just plain .md",
  "keywords": [
    "markdown",
    "editor",
    "block-editor",
    "wysiwyg",
    "prosemirror",
    "milkdown"
  ],
  "license": "MIT",
  "author": "Ruiquan Qiao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuiquanQiao/BlockMD.git"
  },
  "bugs": {
    "url": "https://github.com/RuiquanQiao/BlockMD/issues"
  },
  "homepage": "https://github.com/RuiquanQiao/BlockMD#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:debug": "tauri dev --config \"{\\\"app\\\":{\\\"windows\\\":[{\\\"additionalBrowserArgs\\\":\\\"--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9222\\\"}]}}\"",
    "desktop:build": "tauri build",
    "check:handle": "node scripts/check-handle.mjs",
    "parity": "node scripts/parity.mjs",
    "check:assoc": "powershell -ExecutionPolicy Bypass -File scripts/check-assoc.ps1 .md",
    "check:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/check-uninstall.ps1",
    "corpus": "node scripts/fetch-corpus.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "test:fidelity": "node --test test/fidelity.test.js",
    "pretest:ci": "npm run corpus",
    "test:ci": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@milkdown/kit": "^7.22.1",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "jsdom": "^29.1.1",
    "vite": "^8.3.0"
  }
}
